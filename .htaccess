RewriteEngine On

# 1. Redirect external GET requests for .php to extensionless URLs
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^\s?]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Internally rewrite extensionless URLs to their .php files if they exist
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]
